{
  "name": "MyGesundBox",
  "short_name": "MyGesundBox",
  "description": "MyGesundBox – Arzttermine, Vorsorge, Werte und Dokumente, verschlüsselt auf deinem Gerät.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f9f4f5",
  "theme_color": "#8c2f45",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "dateien",
          "accept": [
            "text/calendar",
            "text/x-vcalendar",
            ".ics",
            "text/csv",
            "text/comma-separated-values",
            ".csv",
            "application/json",
            ".gesundbox",
            "image/*",
            "application/pdf",
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png",
            "application/zip",
            "application/x-zip-compressed",
            ".zip"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Neuer Termin",
      "short_name": "Termin",
      "description": "Arzttermin eintragen",
      "url": "./?go=termin",
      "icons": [
        {
          "src": "shortcuts/termin.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Messung erfassen",
      "short_name": "Messung",
      "description": "Blutdruck, Puls oder Gewicht eintragen",
      "url": "./?go=messung",
      "icons": [
        {
          "src": "shortcuts/messung.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dokument hinzufügen",
      "short_name": "Dokument",
      "description": "Befund, Rezept oder Brief ablegen",
      "url": "./?go=dokument",
      "icons": [
        {
          "src": "shortcuts/dokument.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Termine",
      "short_name": "Termine",
      "description": "Alle Termine anzeigen",
      "url": "./?go=termine",
      "icons": [
        {
          "src": "shortcuts/termine.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
