{
  "name": "Gesundbox",
  "short_name": "Gesundbox",
  "description": "Arzttermine, Vorsorge und Gesundheitswerte – verschlüsselt auf deinem Gerät.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f9f4f5",
  "theme_color": "#8c2f45",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "dateien",
          "accept": [
            "text/calendar",
            "text/x-vcalendar",
            ".ics",
            "text/csv",
            "text/comma-separated-values",
            ".csv",
            "application/json",
            ".gesundbox",
            "image/*",
            "application/pdf",
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png",
            "application/zip",
            "application/x-zip-compressed",
            ".zip"
          ]
        }
      ]
    }
  }
}